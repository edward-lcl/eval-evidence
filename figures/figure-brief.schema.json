{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/edward-lcl/eval-evidence/main/figures/figure-brief.schema.json",
  "title": "Visual system explainer figure brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "title", "question", "takeaway", "readers", "reading_speeds", "archetype", "medium", "evidence_sources", "labels", "boundaries", "forbidden_claims", "accessibility", "provenance", "output"],
  "properties": {
    "schema_version": {"const": 1},
    "title": {"type": "string", "minLength": 1},
    "question": {"type": "string", "minLength": 1},
    "takeaway": {"type": "string", "minLength": 1},
    "readers": {"type": "array", "uniqueItems": true, "minItems": 3, "items": {"enum": ["engineer", "team", "agent-ci"]}},
    "reading_speeds": {
      "type": "object", "additionalProperties": false,
      "required": ["at_2_seconds", "at_20_seconds", "at_2_minutes"],
      "properties": {
        "at_2_seconds": {"type": "string", "minLength": 1},
        "at_20_seconds": {"type": "string", "minLength": 1},
        "at_2_minutes": {"type": "string", "minLength": 1}
      }
    },
    "archetype": {"enum": ["command-switchboard", "value-ladder", "control-boundary", "in-loop-vs-out-of-loop", "lifecycle-evidence-path", "proof-boundary", "bounded-correction-loop"]},
    "medium": {
      "type": "object", "additionalProperties": false, "required": ["kind", "rationale"],
      "properties": {"kind": {"enum": ["svg", "html-css", "mermaid", "imagegen", "hybrid", "data-code-plot"]}, "rationale": {"type": "string", "minLength": 1}}
    },
    "evidence_sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "path", "authority"],
        "properties": {"id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "authority": {"enum": ["source-of-truth", "supporting", "receipt", "inference"]}}
      }
    },
    "labels": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["text", "claim", "source_ids"],
        "properties": {"text": {"type": "string", "minLength": 1}, "claim": {"type": "string", "minLength": 1}, "source_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}}
      }
    },
    "boundaries": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "forbidden_claims": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "accessibility": {
      "type": "object", "additionalProperties": false, "required": ["alt_text", "long_description", "color_independent_cues", "minimum_text_px"],
      "properties": {"alt_text": {"type": "string", "minLength": 1}, "long_description": {"type": "string", "minLength": 1}, "color_independent_cues": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "minimum_text_px": {"type": "integer", "minimum": 12}}
    },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["repository", "revision", "brief_path", "method", "generated_image_used"],
      "properties": {"repository": {"type": "string", "minLength": 1}, "revision": {"type": "string", "minLength": 1}, "brief_path": {"type": "string", "minLength": 1}, "method": {"type": "string", "minLength": 1}, "generated_image_used": {"type": "boolean"}}
    },
    "output": {
      "type": "object", "additionalProperties": false, "required": ["path", "embed_location", "format"],
      "properties": {"path": {"type": "string", "minLength": 1}, "embed_location": {"type": "string", "minLength": 1}, "format": {"enum": ["svg", "png", "webp", "html", "mermaid", "pdf"]}}
    }
  }
}
