{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eval-evidence:schema:bundle:v0.1",
  "title": "Eval Evidence bundle v0.1",
  "type": "object",
  "required": [
    "schema_version", "source", "inputs", "instrument_manifest", "execution",
    "outcome", "item_validity", "verifier_evidence", "attestation", "extensions",
    "bundle_digest"
  ],
  "properties": {
    "schema_version": {"const": "eval-evidence.bundle/v0.1"},
    "source": {
      "type": "object",
      "required": ["adapter", "format", "run_id", "task_id", "task_revision"],
      "properties": {
        "adapter": {"type": "string", "minLength": 1},
        "format": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "task_id": {"type": "string", "minLength": 1},
        "task_revision": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/fileRecord"}
    },
    "instrument_manifest": {"$ref": "#/$defs/instrumentManifest"},
    "execution": {
      "type": "object",
      "required": ["started_at", "finished_at", "metrics"],
      "properties": {
        "started_at": {"type": ["string", "null"]},
        "finished_at": {"type": ["string", "null"]},
        "metrics": {
          "type": "object",
          "required": ["input_tokens", "cache_tokens", "output_tokens", "cost_usd"],
          "properties": {
            "input_tokens": {"type": ["integer", "null"], "minimum": 0},
            "cache_tokens": {"type": ["integer", "null"], "minimum": 0},
            "output_tokens": {"type": ["integer", "null"], "minimum": 0},
            "cost_usd": {"type": ["number", "null"], "minimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "outcome": {
      "type": "object",
      "required": ["reward", "scores", "termination_reason"],
      "properties": {
        "reward": {},
        "scores": {},
        "termination_reason": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "item_validity": {"$ref": "#/$defs/claimSet"},
    "verifier_evidence": {"$ref": "#/$defs/claimSet"},
    "attestation": {
      "type": "object",
      "required": ["type", "signature", "claim"],
      "properties": {
        "type": {"const": "content-digest-only"},
        "signature": {"type": "null"},
        "claim": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "extensions": {"type": "object"},
    "bundle_digest": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {"const": "sha256"},
        "value": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "fileRecord": {
      "type": "object",
      "required": ["path", "role", "required", "present", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "present": {"type": "boolean"},
        "sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": ["integer", "null"], "minimum": 0}
      },
      "allOf": [
        {
          "if": {"properties": {"present": {"const": true}}},
          "then": {
            "properties": {
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "bytes": {"type": "integer", "minimum": 0}
            }
          }
        },
        {
          "if": {"properties": {"present": {"const": false}}},
          "then": {"properties": {"sha256": {"type": "null"}, "bytes": {"type": "null"}}}
        },
        {
          "if": {"properties": {"required": {"const": true}}},
          "then": {"properties": {"present": {"const": true}}}
        }
      ],
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["value", "status", "source"],
      "properties": {
        "value": {},
        "status": {
          "enum": ["observed", "derived", "operator_asserted", "provider_asserted", "unavailable"]
        },
        "source": {"type": "string", "minLength": 1},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "claimSet": {
      "type": "object",
      "required": ["status", "claims", "note"],
      "properties": {
        "status": {"enum": ["unavailable", "reported", "adjudicated", "run_outputs_only"]},
        "claims": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/evidence"}
        },
        "note": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "instrumentManifest": {
      "type": "object",
      "required": ["schema_version", "fields", "coverage"],
      "properties": {
        "schema_version": {"const": "eval-evidence.instrument/v0.1"},
        "fields": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"$ref": "#/$defs/evidence"}
        },
        "coverage": {
          "type": "object",
          "required": ["available_fraction", "field_count", "status_counts"],
          "properties": {
            "available_fraction": {"type": "number", "minimum": 0, "maximum": 1},
            "field_count": {"type": "integer", "minimum": 1},
            "status_counts": {
              "type": "object",
              "required": ["derived", "observed", "operator_asserted", "provider_asserted", "unavailable"],
              "properties": {
                "derived": {"type": "integer", "minimum": 0},
                "observed": {"type": "integer", "minimum": 0},
                "operator_asserted": {"type": "integer", "minimum": 0},
                "provider_asserted": {"type": "integer", "minimum": 0},
                "unavailable": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  }
}
