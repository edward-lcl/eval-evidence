{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eval-evidence:crosswalk:otel-genai:v0.1",
  "title": "Eval Evidence to OpenTelemetry GenAI crosswalk v0.1",
  "status": "informative-partial-mapping",
  "policy": {
    "canonical_contract": "eval-evidence.instrument/v0.1",
    "otel_role": "optional transport subset",
    "warning": "Transport coverage must not turn unavailable fields into observed claims."
  },
  "fields": {
    "model_id": "gen_ai.request.model",
    "response_model": "gen_ai.response.model",
    "model_provider": "gen_ai.provider.name",
    "agent_name": "gen_ai.agent.name",
    "input_tokens": "gen_ai.usage.input_tokens",
    "output_tokens": "gen_ai.usage.output_tokens",
    "cost_usd": null,
    "harness_commit": null,
    "agent_binary_sha256": null,
    "system_prompt_sha256": null,
    "policy_profile_id": null,
    "environment_image_digest": null,
    "verifier_digest": null
  }
}
